{
  "name": "educenter/erp",
  "description": "EduCenter ERP - PHP MVC / CodeIgniter 4",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.2",
    "ext-intl": "*",
    "ext-mbstring": "*",
    "ext-mysqli": "*",
    "codeigniter4/framework": "^4.7",
    "firebase/php-jwt": "^7.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Config\\": "app/Config/"
    }
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true
  },
  "scripts": {
    "test": "php tests/core.php",
    "test:db": "php tests/integration.php",
    "test:admin": "php tests/administration.php",
    "bootstrap-admin": "php spark educenter:bootstrap-admin"
  }
}
