# [THÊM] Sao chép thành database/.env. Đường dẫn này đã được .gitignore bảo vệ.
# [LƯU Ý] Dùng tài khoản triển khai riêng; không phải tài khoản kết nối API sau này.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=trung_tam_gia_su
DB_USER=educenter_migrator
DB_PASSWORD=
# [LƯU Ý] Chỉ nhận utf8mb4; giờ DATETIME của dự án là giờ địa phương +07:00.
DB_CHARSET=utf8mb4
DB_TIMEZONE=+07:00
# [THÊM] Đường dẫn mysql.exe nếu chưa được thêm vào PATH; không thêm dấu nháy.
MYSQL_BIN=mysql
