# [THÊM] Mẫu option file cho MySQL CLI, không phải cấu hình API.
# [LƯU Ý] Script run.ps1 đọc .env và ghi option file tạm, không đọc password từ file mẫu này.
# Có thể tự sao chép file này ra ngoài repo rồi gọi mysql --defaults-extra-file=... -p.
[client]
host=127.0.0.1
port=3306
user=educenter_migrator
default-character-set=utf8mb4
[mysql]
init-command="SET SESSION time_zone='+07:00', SESSION transaction_isolation='READ-COMMITTED'"
