# Mẫu cấu hình cho server Backend EduCenter ERP.
# Sao chép thành config/server.env và đặt mật khẩu riêng khi chạy.
CI_ENVIRONMENT=production
APP_BASE_URL=http://localhost:5000/
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=trung_tam_gia_su
DB_USER=educenter_api
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_TIMEZONE=+07:00
JWT_SECRET=
JWT_EXPIRES_IN=8h
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
# SMTP local: thư chỉ hiển thị ở http://localhost:8025/, không gửi ra email thật.
MAIL_PROTOCOL=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_EMAIL=noreply@educenter.test
MAIL_FROM_NAME=EduCenter
# Khi triển khai, thay SMTP riêng của bạn; không dùng Mailpit để gửi thư thật.
# Trong Docker, compose tự đổi DB_HOST thành educenter-mysql và DB_PORT thành 3306.
# Khi cài PHP trực tiếp trên Windows, giữ DB_HOST=127.0.0.1 và DB_PORT=3307.
